# Sentence Transformer model downloaded from Hugging Face at startup
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Public API deployment
CORS_ORIGINS=https://YOUR-OWNER.github.io/YOUR-REPOSITORY

# Required in production; generate a long random value
SECRET_KEY=replace-with-a-long-random-secret

# Use a managed database URL in production when possible
DATABASE_URL=sqlite:///./collabx.db

